{
  "$schema": "https://smithery.ai/schemas/mcp.json",
  "name": "@npmsolsentry/mcp",
  "version": "3.1.5",
  "description": "Model Context Protocol server for SolSentry. Add it to Claude, Cursor, or any MCP client to guard Solana transactions and score protocol risk. Thin stdio proxy; holds no keys.",
  "repository": {
    "url": "https://github.com/shieldspprt/solsentry",
    "directory": "packages/mcp"
  },
  "homepage": "https://solsentry.netlify.app",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "ai-agents",
    "claude",
    "cursor",
    "transaction-simulation",
    "wallet-drainer"
  ],
  "command": "npx",
  "args": [
    "-y",
    "@npmsolsentry/mcp"
  ],
  "env": {
    "SOLSENTRY_URL": {
      "type": "string",
      "description": "Base URL of the SolSentry engine (default: https://solsentry.netlify.app)",
      "default": "https://solsentry.netlify.app",
      "required": false
    },
    "SOLSENTRY_API_KEY": {
      "type": "string",
      "description": "API key for authenticated requests to the SolSentry engine (optional)",
      "required": false,
      "secret": true
    },
    "SOLSENTRY_TIMEOUT_MS": {
      "type": "number",
      "description": "Request timeout in milliseconds (default: 20000)",
      "default": 20000,
      "required": false
    }
  },
  "tools": [
    {
      "name": "solsentry_guard_transaction",
      "description": "Simulate transaction bytes, scan for drainers, and optionally apply protocol risk and policy guardrails. Returns SIGN or DO_NOT_SIGN.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transaction": {
            "type": "string",
            "description": "Serialized Solana transaction (base58 or base64)"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "base58",
              "base64"
            ],
            "default": "base58"
          },
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          },
          "action": {
            "type": "string",
            "enum": [
              "swap",
              "lend",
              "borrow",
              "lp",
              "stake",
              "perp_long",
              "perp_short",
              "buy_bonding_curve"
            ],
            "description": "Transaction action"
          },
          "amountUsd": {
            "type": "number",
            "minimum": 0
          },
          "currentDailyVolumeUsd": {
            "type": "number",
            "minimum": 0
          },
          "currentDrawdownPct": {
            "type": "number",
            "minimum": 0
          },
          "openPositionsCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "transaction"
        ]
      }
    },
    {
      "name": "solsentry_simulate_transaction",
      "description": "Dry-run a transaction and report balance deltas, inner SPL transfers, compute units, and drainer signals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transaction": {
            "type": "string"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "base58",
              "base64"
            ],
            "default": "base58"
          }
        },
        "required": [
          "transaction"
        ]
      }
    },
    {
      "name": "solsentry_check_protocol_risk",
      "description": "Compute the grounded eight-factor risk score for a supported protocol.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          }
        },
        "required": [
          "protocolSlug"
        ]
      }
    },
    {
      "name": "solsentry_get_protocol_list",
      "description": "List monitored protocols with live telemetry and risk ratings.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "solsentry_evaluate_policy",
      "description": "Evaluate a proposed action against financial guardrails.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          },
          "action": {
            "type": "string",
            "enum": [
              "swap",
              "lend",
              "borrow",
              "lp",
              "stake",
              "perp_long",
              "perp_short",
              "buy_bonding_curve"
            ],
            "description": "Transaction action"
          },
          "amountUsd": {
            "type": "number",
            "minimum": 0.01
          },
          "currentDailyVolumeUsd": {
            "type": "number",
            "minimum": 0
          },
          "currentDrawdownPct": {
            "type": "number",
            "minimum": 0
          },
          "openPositionsCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "protocolSlug",
          "action",
          "amountUsd"
        ]
      }
    },
    {
      "name": "solsentry_preflight",
      "description": "Run protocol risk and policy evaluation together for one pre-trade verdict.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          },
          "action": {
            "type": "string",
            "enum": [
              "swap",
              "lend",
              "borrow",
              "lp",
              "stake",
              "perp_long",
              "perp_short",
              "buy_bonding_curve"
            ],
            "description": "Transaction action"
          },
          "amountUsd": {
            "type": "number",
            "minimum": 0.01
          },
          "currentDailyVolumeUsd": {
            "type": "number",
            "minimum": 0
          },
          "currentDrawdownPct": {
            "type": "number",
            "minimum": 0
          },
          "openPositionsCount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "protocolSlug",
          "action",
          "amountUsd"
        ]
      }
    },
    {
      "name": "solsentry_stress_test",
      "description": "Apply an adverse price shock and report liquidation and capital-at-risk outcomes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          },
          "agentId": {
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          },
          "priceShockPct": {
            "type": "number",
            "minimum": -95,
            "maximum": 0
          }
        }
      }
    },
    {
      "name": "solsentry_get_position_health",
      "description": "Read on-chain positions and evaluate health factors and liquidation distance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          },
          "agentId": {
            "type": "string"
          },
          "walletAddress": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "solsentry_get_business_ratios",
      "description": "Compute protocol fee-to-TVL, revenue capture, and TVL efficiency metrics.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "protocolSlug": {
            "type": "string",
            "enum": [
              "kamino",
              "drift",
              "jupiter",
              "orca",
              "raydium",
              "meteora",
              "marinade",
              "jito",
              "pumpfun"
            ],
            "description": "Target protocol slug"
          }
        },
        "required": [
          "protocolSlug"
        ]
      }
    }
  ]
}
