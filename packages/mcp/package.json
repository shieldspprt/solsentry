{
  "name": "@solsentry/mcp",
  "version": "3.1.0",
  "description": "Model Context Protocol server for SolSentry. Add it to Claude, Cursor, or any MCP client to guard Solana transactions and score protocol risk. Thin stdio proxy; holds no keys.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "ai-agents",
    "claude",
    "cursor",
    "transaction-simulation",
    "wallet-drainer"
  ],
  "license": "MIT",
  "homepage": "https://solsentry.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shieldspprt/solsentry.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/shieldspprt/solsentry/issues"
  },
  "type": "module",
  "bin": {
    "solsentry-mcp": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.16"
  },
  "engines": {
    "node": ">=18"
  }
}
