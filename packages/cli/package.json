{
  "name": "@npmsolsentry/cli",
  "version": "3.1.0",
  "description": "SolSentry command line tool: guard a Solana transaction before signing, score protocol risk, and check policy from your terminal.",
  "keywords": [
    "solana",
    "cli",
    "ai-agents",
    "transaction-simulation",
    "wallet-drainer",
    "defi-risk"
  ],
  "license": "MIT",
  "homepage": "https://solsentry.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shieldspprt/solsentry.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/shieldspprt/solsentry/issues"
  },
  "bin": {
    "npmsolsentry-cli": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@npmsolsentry/sdk": "^3.1.0",
    "@solana/web3.js": "^1.95.8",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "table": "^6.8.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^20.17.16"
  },
  "engines": {
    "node": ">=18"
  }
}
